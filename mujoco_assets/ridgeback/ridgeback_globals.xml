<!-- ridgeback_globals.xml-->
<ridgeback_globals>
  <default>
    <default class="rail">
      <joint armature="0.1" damping="1" axis="0 0 1" range="-5.0 5.0" />
      <general
        dyntype="none"
        biastype="affine"
        ctrlrange="-5.0 5.0"
        forcerange="-50000 50000"
      />
    </default>
  </default>
  <default>
    <default class="wheel_drive">
      <joint armature="0.002" damping="0.1" axis="0 1 0" />
      <velocity kv="5.0" />
    </default>
  </default>
  <asset>
    <!-- Ridgeback -->
    <mesh name="chassis_link" file="body.stl" />
    <mesh name="top_link" file="top.stl" />
  </asset>
  <actuator>
    <position
      class="rail"
      name="linear_x_joint"
      joint="linear_x_joint"
      kp="75000"
      dampratio="1.0"
    />
    <position
      class="rail"
      name="linear_y_joint"
      joint="linear_y_joint"
      kp="75000"
      dampratio="1.0"
    />
    <!-- <position
      name="rotational_yaw_joint"
      joint="rotational_yaw_joint"
      kp="75000"
      dampratio="1.0"
    /> -->
  </actuator>
  <actuator>
    <velocity name="front_left_wheel_drive" class="wheel_drive" joint="front_left_wheel" />
    <velocity name="front_right_wheel_drive" class="wheel_drive" joint="front_right_wheel" />
    <velocity name="rear_left_wheel_drive" class="wheel_drive" joint="rear_left_wheel" />
    <velocity name="rear_right_wheel_drive" class="wheel_drive" joint="rear_right_wheel" />
  </actuator>
</ridgeback_globals>